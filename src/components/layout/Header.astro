---
import Wordmark from './Wordmark.astro'
import Button from '../ui/Button.astro'
import { navLinks, product } from '../../content/product'
import ThemePicker from './ThemePicker.astro'
---

<header
  class="sticky top-4 sm:top-6 z-50 mx-auto w-[calc(100%-2rem)] max-w-5xl rounded-full border border-zinc-200/60 bg-white/80 shadow-[0_8px_30px_rgba(0,0,0,0.06)] backdrop-blur-lg transition-all dark:border-zinc-700/60 dark:bg-zinc-900/80 dark:shadow-[0_8px_30px_rgba(0,0,0,0.3)]"
>
  <nav
    class="flex items-center justify-between gap-4 px-4 py-2.5 sm:px-6 sm:py-3"
    aria-label="Main"
  >
    <a href="/" class="rounded-lg">
      <Wordmark />
    </a>
    <div class="flex items-center gap-1 sm:gap-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="hidden rounded-lg px-3 py-2 text-sm font-medium text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 sm:block dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
          >
            {link.label}
          </a>
        ))
      }
      <ThemePicker />
      <Button href={product.repositoryUrl || '/#features'} size="sm">
        Get Started
      </Button>
    </div>
  </nav>
</header>
