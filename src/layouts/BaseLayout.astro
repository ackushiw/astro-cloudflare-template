---
import '../styles/global.css'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import { product } from '../content/product'
import { siteThemes, THEME_STORAGE_KEY } from '../content/theme'
import ThemedImage from '../components/ui/ThemedImage.astro'

interface Props {
  title: string
  description: string
  /** Robots directive override, e.g. "noindex" for the 404 page. */
  robots?: string
}

const { title, description, robots } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.url.origin)
const socialImage = new URL('/og-image.png', Astro.url.origin)
---

<html
  lang="en"
  style={`--theme-primary-light: ${siteThemes.light.primary}; --theme-primary-dark: ${siteThemes.dark.primary};`}
>
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&display=swap"
      rel="stylesheet"
    />
    <!--
      `viewport-fit=cover` is what makes `env(safe-area-inset-*)` resolve to
      anything other than zero. Without it the safe-area padding in the footer
      is silently inert on every notched phone.
    -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {robots && <meta name="robots" content={robots} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={product.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" data-theme-color content="#fdfcfe" />
    <script is:inline define:vars={{ THEME_STORAGE_KEY, siteThemes }}>
      ;(function () {
        const STORAGE_KEY = THEME_STORAGE_KEY
        const themes = siteThemes

        let currentMode = 'system'

        try {
          const stored = localStorage.getItem(STORAGE_KEY)
          if (stored === 'light' || stored === 'dark' || stored === 'system') {
            currentMode = stored
          }
        } catch (e) {
          // localStorage fails (e.g. privacy settings or iframe)
        }

        const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)')

        function resolveTheme(mode) {
          if (mode === 'system') {
            return mediaQuery.matches ? 'dark' : 'light'
          }
          return mode
        }

        function setMode(mode) {
          if (mode !== 'light' && mode !== 'dark' && mode !== 'system') {
            return
          }
          currentMode = mode
          try {
            localStorage.setItem(STORAGE_KEY, mode)
          } catch (e) {
            // persistence skipped
          }

          const resolved = resolveTheme(mode)
          const isDark = resolved === 'dark'

          document.documentElement.classList.toggle('dark', isDark)
          document.documentElement.dataset.theme = resolved
          document.documentElement.dataset.themeMode = mode

          const meta = document.querySelector('meta[data-theme-color]')
          if (meta) {
            meta.setAttribute('content', themes[resolved].themeColor)
          }

          window.dispatchEvent(
            new CustomEvent('site:theme-change', {
              detail: { mode, resolvedTheme: resolved },
            }),
          )
        }

        // Expose public API
        window.siteTheme = {
          getMode: () => currentMode,
          getResolvedTheme: () => resolveTheme(currentMode),
          setMode: setMode,
        }

        // Initialize immediately
        setMode(currentMode)

        // Listen for system theme changes
        mediaQuery.addEventListener('change', () => {
          if (currentMode === 'system') {
            setMode('system')
          }
        })
      })()
    </script>
  </head>
  <body class="font-sans text-zinc-800 antialiased dark:text-zinc-200">
    <div class="fixed inset-0 z-0 pointer-events-none">
      <ThemedImage
        class="h-full w-full object-cover scale-105 blur-sm opacity-90"
        applyWallpaperPosition
      />
    </div>
    <div class="min-h-app relative z-10 flex flex-col">
      <a
        href="#main"
        class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-primary-600 focus:px-4 focus:py-2 focus:text-white"
      >
        Skip to content
      </a>
      <Header />
      <main id="main" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
    <script is:inline>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
            }
          })
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' },
      )
      document.addEventListener(
        'astro:page-load',
        () => {
          document.querySelectorAll('.reveal-on-scroll').forEach((el) => observer.observe(el))
        },
        { once: false },
      )
      // Run on initial load too, just in case astro:page-load fires late
      document.querySelectorAll('.reveal-on-scroll').forEach((el) => observer.observe(el))
    </script>
  </body>
</html>
