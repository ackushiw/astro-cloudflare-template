---
import Wordmark from './Wordmark.astro'
import { product, navLinks } from '../../content/product'

const year = new Date().getFullYear()
---

<footer
  class="w-full bg-surface-light dark:bg-surface-dark border-t border-zinc-200/50 dark:border-zinc-800/50"
>
  <div
    class="mx-auto max-w-5xl px-4 pt-16 pb-12 sm:px-6 lg:px-8 lg:pt-20 lg:pb-[calc(4rem+env(safe-area-inset-bottom,0px))]"
  >
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12">
      <!-- Brand & Description Column -->
      <div class="flex flex-col gap-4 md:col-span-6 lg:col-span-7">
        <a href="/" class="self-start rounded-lg focus-visible:outline-none">
          <Wordmark />
        </a>
        <p class="max-w-md text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
          {product.description}
        </p>
      </div>

      <!-- Navigation & Links Columns -->
      <div class="grid grid-cols-2 gap-8 sm:gap-12 md:col-span-6 lg:col-span-5">
        <!-- Links -->
        <div class="flex flex-col gap-4">
          <h3
            class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100"
          >
            Navigation
          </h3>
          <ul class="flex flex-col gap-3 text-sm">
            <li>
              <a
                href="/"
                class="rounded text-zinc-600 underline-offset-4 hover:underline dark:text-zinc-400 dark:hover:text-zinc-200"
              >
                Home
              </a>
            </li>
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="rounded text-zinc-600 underline-offset-4 hover:underline dark:text-zinc-400 dark:hover:text-zinc-200"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Support Column -->
        <div class="flex flex-col gap-4">
          <h3
            class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100"
          >
            Support
          </h3>
          <ul class="flex flex-col gap-3 text-sm">
            {
              product.contactEmail && (
                <li>
                  <a
                    href={`mailto:${product.contactEmail}`}
                    class="rounded text-zinc-600 underline-offset-4 hover:underline dark:text-zinc-400 dark:hover:text-zinc-200"
                  >
                    Contact Support
                  </a>
                </li>
              )
            }
            {
              product.privacyEmail && (
                <li>
                  <a
                    href={`mailto:${product.privacyEmail}`}
                    class="rounded text-zinc-600 underline-offset-4 hover:underline dark:text-zinc-400 dark:hover:text-zinc-200"
                  >
                    Privacy Inquiries
                  </a>
                </li>
              )
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom sub-footer -->
    <div
      class="mt-16 border-t border-zinc-200/60 pt-8 dark:border-zinc-800/60 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-xs text-zinc-500 dark:text-zinc-400">
        &copy; {year} {product.copyrightHolder}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
