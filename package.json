{
  "name": "astro-cloudflare-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Generic starter template for Astro deployed to Cloudflare",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:astro": "astro check",
    "format:astro": "prettier --write \"src/**/*.astro\"",
    "format:astro:check": "prettier --check \"src/**/*.astro\"",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/tabler": "^1.2.38",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "astro-icon": "^1.2.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "sharp": "^0.35.4",
    "typescript": "5.9.3",
    "vite-plus": "0.3.1",
    "wrangler": "4.131.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.12.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
